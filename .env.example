# Copy to .env and fill in your values. Never commit .env.
# Provider: zen | gemini | groq | huggingface (key var + defaults follow it)
PROVIDER=zen
OPENCODE_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# HF_TOKEN=
# TOKENROUTER_API_KEY=
# Optional per-provider overrides ({PREFIX}_BASE_URL, {PREFIX}_PERSONA_MODEL,
# {PREFIX}_RESPONDENT_MODEL — e.g. TOKENROUTER_BASE_URL). Precedence:
# CLI flag > {PREFIX}_* env > ZEN_* env > preset default.
ZEN_BASE_URL=https://opencode.ai/zen/v1
ZEN_MODEL_PERSONA=big-pickle
ZEN_MODEL_RESPONDENT=big-pickle
NUM_SAMPLES=2000
CONCURRENCY=8
TEMPERATURE=1.1
OUTPUT_PATH=dataset/peta_arah_minat.jsonl
LOG_LEVEL=INFO
LOG_FILE=
SEED=
RESUME=true
MAX_FAILURE_RATE=0.5
GATE_WARMUP=10
